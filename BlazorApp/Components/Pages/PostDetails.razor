@page "/posts/{Id:int}"
@using ApiContracts
@using BlazorApp.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IPostService PostService
@inject IUserService UserService
@inject ICommentService CommentService

<h3>Post Details</h3>

@if (post == null)
{
    <p>Loading...</p>
}
else
{
    <h4>@post.Title</h4>
    <p>@post.Body</p>
    <p>Author: @authorName</p>

    <h5>Comments</h5>

    @foreach (CommentDto comment in comments)
    {
        <div>
            <p>@comment.Body</p>
        </div>
    }

    <AuthorizeView>
        <Authorized>
            <h5>Add Comment</h5>

            <textarea @bind="commentBody"></textarea>

            <br />

            <button @onclick="AddCommentAsync">Add Comment</button>

            <p>@message</p>
        </Authorized>
    </AuthorizeView>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> State { get; set; } = null!;

    private PostDto? post;
    private List<CommentDto> comments = new();
    private string authorName = "";
    private string commentBody = "";
    private string message = "";
    private int userId;

    protected override async Task OnInitializedAsync()
    {
        post = await PostService.GetPostAsync(Id);

        UserDto user = await UserService.GetUserAsync(post.UserId);
        authorName = user.UserName;

        comments = await CommentService.GetCommentsByPostIdAsync(Id);

        AuthenticationState authenticationState = await State;

        if (authenticationState.User.Identity?.IsAuthenticated == true)
        {
            string? userIdAsString = authenticationState.User
                .Claims
                .SingleOrDefault(claim => claim.Type == "Id")
                ?.Value;

            if (userIdAsString != null)
            {
                userId = int.Parse(userIdAsString);
            }
        }
    }

    private async Task AddCommentAsync()
    {
        CreateCommentDto request = new CreateCommentDto
        {
            Body = commentBody,
            UserId = userId,
            PostId = Id
        };

        await CommentService.AddCommentAsync(request);

        comments = await CommentService.GetCommentsByPostIdAsync(Id);

        commentBody = "";
        message = "Comment added.";
    }
}