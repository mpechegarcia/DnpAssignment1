@page "/create-post"
@attribute [Authorize]
@using ApiContracts
@using BlazorApp.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IPostService PostService

<h3>Create Post</h3>

<div>
    <label>Title:</label>
    <input @bind="title" />
</div>

<div>
    <label>Body:</label>
    <textarea @bind="body"></textarea>
</div>

<button @onclick="CreatePostAsync">Create Post</button>

<p>@message</p>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> State { get; set; } = null!;

    private string title = "";
    private string body = "";
    private string message = "";
    private int userId;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authenticationState = await State;

        string userIdAsString = authenticationState.User
            .Claims
            .Single(claim => claim.Type == "Id")
            .Value;

        userId = int.Parse(userIdAsString);
    }

    private async Task CreatePostAsync()
    {
        CreatePostDto request = new CreatePostDto
        {
            Title = title,
            Body = body,
            UserId = userId
        };

        PostDto post = await PostService.AddPostAsync(request);

        message = $"Post created with ID: {post.Id}";
    }
}